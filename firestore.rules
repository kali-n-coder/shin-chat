rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUser().data.status == "active";
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isActive() && currentUser().data.role == "admin");
    }

    function validBaseProfile(data) {
      return data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 30
        && data.email == request.auth.token.email
        && (data.photoURL == null || data.photoURL is string)
        && data.status == "active"
        && (data.role == "member" || (data.role == "admin" && isBootstrapAdmin()));
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && validBaseProfile(request.resource.data);
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin()
        || (isActive()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["displayName", "photoURL", "lastSeenAt"])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 30);
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["displayName", "photoURL", "friendCode", "updatedAt"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.matches('^NG-[A-Z0-9_-]{4}-[A-Z0-9_-]{4}-[A-Z0-9_-]{4}$')
        && existsAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode))
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == userId;
      allow update: if isActive()
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.matches('^NG-[A-Z0-9_-]{4}-[A-Z0-9_-]{4}-[A-Z0-9_-]{4}$')
        && existsAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode))
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "photoURL", "friendCode", "updatedAt"]);
      allow delete: if false;
    }

    match /friendCodes/{friendCode} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && friendCode.matches('^NG-[A-Z0-9_-]{4}-[A-Z0-9_-]{4}-[A-Z0-9_-]{4}$');
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if isActive()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(["fromUid", "toUid", "fromProfile", "toProfile", "status", "createdAt"])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestId == request.auth.uid + "_" + request.resource.data.toUid
        && request.resource.data.status == "pending"
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.toUid)).data.status == "active"
        && request.resource.data.fromProfile.displayName == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.displayName
        && request.resource.data.fromProfile.photoURL == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.photoURL
        && request.resource.data.fromProfile.friendCode == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.friendCode
        && request.resource.data.toProfile.displayName == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.toUid)).data.displayName
        && request.resource.data.toProfile.photoURL == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.toUid)).data.photoURL
        && request.resource.data.toProfile.friendCode == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.toUid)).data.friendCode;
      allow update: if isActive()
        && request.auth.uid == resource.data.toUid
        && resource.data.status == "pending"
        && (request.resource.data.status == "accepted" || request.resource.data.status == "declined")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"]);
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if isActive() && request.auth.uid in resource.data.memberIds;
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(["memberIds", "memberProfiles", "createdAt", "updatedAt"])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] != request.resource.data.memberIds[1]
        && request.auth.uid in request.resource.data.memberIds
        && friendshipId == request.resource.data.memberIds[0] + "_" + request.resource.data.memberIds[1]
        && request.resource.data.memberProfiles is map
        && request.resource.data.memberProfiles.keys().hasAll(request.resource.data.memberIds)
        && request.resource.data.memberProfiles[request.resource.data.memberIds[0]].displayName == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.memberIds[0])).data.displayName
        && request.resource.data.memberProfiles[request.resource.data.memberIds[0]].friendCode == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.memberIds[0])).data.friendCode
        && request.resource.data.memberProfiles[request.resource.data.memberIds[1]].displayName == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.memberIds[1])).data.displayName
        && request.resource.data.memberProfiles[request.resource.data.memberIds[1]].friendCode == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.memberIds[1])).data.friendCode
        && ((exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.memberIds[0] + "_" + request.resource.data.memberIds[1]))
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.memberIds[0] + "_" + request.resource.data.memberIds[1])).data.status == "pending"
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.memberIds[0] + "_" + request.resource.data.memberIds[1])).data.toUid == request.auth.uid)
          || (exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.memberIds[1] + "_" + request.resource.data.memberIds[0]))
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.memberIds[1] + "_" + request.resource.data.memberIds[0])).data.status == "pending"
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.memberIds[1] + "_" + request.resource.data.memberIds[0])).data.toUid == request.auth.uid));
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isActive()
        && exists(/databases/$(database)/documents/friendships/$(conversationId))
        && request.auth.uid in resource.data.participantIds;
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(["participantIds", "participantProfiles", "lastMessage", "createdAt", "updatedAt", "lastMessageAt"])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && exists(/databases/$(database)/documents/friendships/$(conversationId))
        && request.resource.data.participantIds == get(/databases/$(database)/documents/friendships/$(conversationId)).data.memberIds
        && request.resource.data.participantProfiles is map
        && request.resource.data.participantProfiles.keys().hasAll(request.resource.data.participantIds)
        && request.resource.data.participantProfiles[request.resource.data.participantIds[0]].displayName
          == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participantIds[0])).data.displayName
        && request.resource.data.participantProfiles[request.resource.data.participantIds[1]].displayName
          == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participantIds[1])).data.displayName
        && request.resource.data.lastMessage == "";
      allow update: if isActive()
        && exists(/databases/$(database)/documents/friendships/$(conversationId))
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantProfiles == resource.data.participantProfiles
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["lastMessage", "lastMessageAt", "updatedAt"])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 100;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isActive()
          && exists(/databases/$(database)/documents/friendships/$(conversationId))
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isActive()
          && exists(/databases/$(database)/documents/friendships/$(conversationId))
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 30
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.isHidden == false;
        allow update: if (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isHidden"]))
          || (isActive()
            && exists(/databases/$(database)/documents/friendships/$(conversationId))
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
            && resource.data.senderId == request.auth.uid
            && resource.data.isHidden == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "editedAt"])
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000);
        allow delete: if false;
      }
    }

    match /rooms/{roomId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type == "public"
        && request.resource.data.isArchived == false
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 100;
      allow update: if isAdmin();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 30
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.isHidden == false;
        allow update: if (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isHidden"]))
          || (isActive()
            && resource.data.senderId == request.auth.uid
            && resource.data.isHidden == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "editedAt"])
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000);
        allow delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if isActive()
        && reportId == request.auth.uid + "_" + request.resource.data.messageId
        && request.resource.data.reportedBy == request.auth.uid
        && (request.resource.data.targetType == "room" || request.resource.data.targetType == "conversation")
        && request.resource.data.targetId is string
        && request.resource.data.messageId is string
        && request.resource.data.messagePreview is string
        && request.resource.data.messagePreview.size() <= 140
        && request.resource.data.reason is string
        && request.resource.data.status == "pending"
        && ((request.resource.data.targetType == "room"
            && exists(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)/messages/$(request.resource.data.messageId))
            && get(/databases/$(database)/documents/rooms/$(request.resource.data.targetId)/messages/$(request.resource.data.messageId)).data.senderId != request.auth.uid)
          || (request.resource.data.targetType == "conversation"
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)).data.participantIds
            && exists(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)/messages/$(request.resource.data.messageId))
            && get(/databases/$(database)/documents/conversations/$(request.resource.data.targetId)/messages/$(request.resource.data.messageId)).data.senderId != request.auth.uid));
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "resolvedAt", "resolvedBy"])
        && (request.resource.data.status == "resolved" || request.resource.data.status == "dismissed");
      allow delete: if false;
    }
  }
}
